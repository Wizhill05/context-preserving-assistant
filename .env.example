# Application Configuration
PORT=3000
NODE_ENV=development

# Run Mode: 'mock' for local offline testing/demo without Auth0 credentials; 'auth0' for live Auth0 Universal Login
AUTH_MODE=mock

# Auth0 Universal Login (express-openid-connect)
# Required when AUTH_MODE=auth0
ISSUER_BASE_URL=https://YOUR_DOMAIN.auth0.com
CLIENT_ID=YOUR_CLIENT_ID
CLIENT_SECRET=YOUR_CLIENT_SECRET
SECRET=a_long_random_session_secret_at_least_32_characters_long_1234567890
BASE_URL=http://localhost:3000

# Auth0 First-Party API Identifier (Audience)
API_AUDIENCE=https://api.assistant.local

# Optional Auth0 Token Vault Configuration (for external providers like Google Calendar)
# Used by the pluggable Token Vault adapter
TOKEN_VAULT_ENABLED=false
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
